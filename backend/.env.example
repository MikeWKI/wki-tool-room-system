# Environment Variables for WKI Tool Room Inventory System

# Server Configuration
PORT=3001
NODE_ENV=production

# How many proxies Express should trust before the client address.
# Default 1 is Render's load balancer in front of Cloudflare. Leave unset on Render
# unless scripts/check-ratelimit.sh still shows a jumpy X-RateLimit-Remaining
# after deploy; then set 2. See backend/middleware/clientIp.js.
# TRUST_PROXY_HOPS=1

# CORS allowlist used by server.js.
# Defaults to https://wki-tool-room-system.onrender.com when unset.
# localhost:3000 and 127.0.0.1:3000 are added only when NODE_ENV is not production.
# FRONTEND_ORIGIN=https://wki-tool-room-system.onrender.com

# Render.com External Hostname (set automatically by Render)
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com

# MongoDB Configuration
# Replace this with your actual MongoDB Atlas connection string
# Get this from MongoDB Atlas -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/WKI-ToolRoomINV-WIC?retryWrites=true&w=majority

# MongoDB Database Name (optional - defaults to database name in URI)
DB_NAME=WKI-ToolRoomINV-WIC

# Legacy file-based database path (fallback when MongoDB unavailable)
DATABASE_PATH=./database

# Access control (set on Render — never commit real values)
MANAGE_PIN=
CAMERA_ACCESS_PASSWORD=

# Optional HMAC key for manage sessions (about 10 hours).
# When unset, the key is derived from MANAGE_PIN so no new env var is required.
# Set a long random value so rotating MANAGE_PIN does not depend on that derivation.
# SESSION_SECRET=

# Optional camera feed URLs. Returned only after a correct camera password.
# Defaults are the current tool-room LAN guest pages.
# CAMERA_WEST_URL=
# CAMERA_EAST_URL=

# Reconcile apply gate — fill-gaps only when true (never delete parts).
# Leave false unless a person explicitly enables it on the API service.
RECONCILE_APPLY_TO_LIVE=false

# Shop activity history (POST /api/audit/load-activity) uses MANAGE_PIN.
# It does not delete parts. Re-running replaces only that activity batch.

# Door accountability. Do not commit real secrets.
# Webhook shared secret. If unset, POST /api/door/events and /api/door/email-inbound return 503.
# DOOR_WEBHOOK_SECRET=
# Header the reader must send: X-Door-Webhook-Secret
# DOOR_VISIT_WINDOW_MINUTES=10
# DOOR_ACK_SUPPRESSES_ALERT=false
# DOOR_EMAIL_PATTERN=
# EOD_SWEEP_TIME=17:00
# EOD_SWEEP_DAYS=Mon-Fri
# ALERTS_MODE=dry_run
# ALERT_SUPERVISOR_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ALERT_FROM=